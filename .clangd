# This repository is built exclusively inside the CUDA container on gpu-01,
# never on the machine running the editor. There is no local CUDA toolkit and
# no compile_commands.json, so clangd parses every .cc/.cu file with no flags:
# `#include <cuda_runtime.h>` fails, clangd stops resolving names after it, and
# each affected file reports a cascade of "use of undeclared identifier" errors
# for pybind11, ft, DLDevice and so on.
#
# Those are artifacts of the missing toolchain, not defects. bind.cpp compiles
# cleanly on gpu-01 on every build cycle, verified by the sm_70 machine-code
# check the job runs after linking.
#
# Suppressing the pp_file_not_found diagnostic for the CUDA headers keeps the
# real diagnostics visible. Without this, genuine problems in the same file are
# buried under twenty cascade errors, which is exactly how a real defect gets
# missed -- the signal is drowned by noise that everyone learns to skip past.
Diagnostics:
  Suppress:
    # The failing include itself.
    - pp_file_not_found
    # Everything downstream of it. Verified by running lsp_diagnostics on
    # bind.cpp and adding exactly the codes it reported, rather than guessing:
    # namespace aliases (py = pybind11), the PYBIND11_MAKE_OPAQUE macro,
    # DLDevice/Tensor/cudaPointerAttributes types, and the error-limit notice
    # that fires once the cascade is long enough.
    - undeclared_var_use
    - typename_nested_not_found
    - expected_namespace_name
    - unknown_typename
    - fatal_too_many_errors
